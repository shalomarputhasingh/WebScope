# ─────────────────────────────────────────────────────────────
#  WebScope — copy this file to `.env.local` and fill it in:
#     cp .env.example .env.local
#  Tips: keep values in "double quotes" (safe with spaces), no spaces around "=",
#        and never put a "#" comment on the same line as a value.
# ─────────────────────────────────────────────────────────────

# 1) Groq (AI) — free key: https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
# Tokens-per-minute budget used to pace requests. Keep it a bit under your Groq limit
# (free tier is often 6000-8000 per model).
GROQ_TPM="6000"

# 2) Web search — free tier (1,000 searches/month, no card): https://app.tavily.com
#    Leave empty to fall back to Wikipedia only.
TAVILY_API_KEY=""

# 3) Gmail SMTP (sends the PDF + summary)
#    - Turn on 2-Step Verification, then create an App Password:
#      https://myaccount.google.com/apppasswords
#    - Google shows it as 4 groups with spaces, e.g.  abcd efgh ijkl mnop
#      Paste it AS-IS between the quotes. Spaces are removed automatically.
#    - Your normal Gmail password will NOT work.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="you@gmail.com"
SMTP_PASSWORD="abcd efgh ijkl mnop"
MAIL_FROM_NAME="WebScope"
