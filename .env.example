# Groq — get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gmail SMTP — use an App Password (Google Account > Security > 2-Step Verification > App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
# Optional display name / from address (defaults to SMTP_USER)
MAIL_FROM_NAME=WebScope
