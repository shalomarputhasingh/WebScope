# Groq — get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Web search (optional but recommended) — free tier: 1,000 searches/month, no card: https://app.tavily.com
# Without it, WebScope falls back to Wikipedia only.
TAVILY_API_KEY=

# Gmail SMTP — use an App Password (Google Account > Security > 2-Step Verification > App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
MAIL_FROM_NAME=WebScope
